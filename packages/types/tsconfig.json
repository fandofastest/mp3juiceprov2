{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@headless/types": ["../../packages/types/dist/index.d.ts"],
      "@headless/utils": ["../../packages/utils/dist/index.d.ts"],
      "@headless/database": ["../../packages/database/dist/index.d.ts"],
      "@headless/auth": ["../../packages/auth/dist/index.d.ts"],
      "@headless/providers": ["../../packages/providers/dist/index.d.ts"],
      "@headless/ui": ["../../packages/ui/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
